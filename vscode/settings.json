{
  "update.showReleaseNotes": false,
  "editor.minimap.enabled": false,
  "files.autoSave": "afterDelay",
  "workbench.startupEditor": "newUntitledFile",
  "explorer.confirmDelete": false,
  "editor.hover.sticky": false,
  "workbench.tree.renderIndentGuides": "none",
  "editor.formatOnSave": true,
  "explorer.confirmDragAndDrop": false,
  "editor.acceptSuggestionOnCommitCharacter": false,
  "[json]": {
    "editor.quickSuggestions": {
      "strings": true,
    },
    "editor.suggest.insertMode": "replace",
  },
  "editor.hover.enabled": "off",
  "terminal.integrated.inheritEnv": false,
  "editor.detectIndentation": false,
  "editor.tabSize": 2,
  "diffEditor.wordWrap": "off",
  "editor.wordWrap": "on",
  "workbench.colorTheme": "GitHub Dark",
  "debug.javascript.terminalOptions": {},
  "editor.acceptSuggestionOnEnter": "off",
  "git.openRepositoryInParentFolders": "never",
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "workbench.colorCustomizations": {
    "tab.activeBackground": "#666666cc",
    // cmd+fで検索時の色
    "editor.findMatchBackground": "#ff6a0090",
    "editor.findMatchBorder": "#ff6a00",
    "editor.findMatchForeground": "#ffffff",
    "editor.findMatchHighlightBackground": "#ffd33d40",
    "editor.findMatchHighlightBorder": "#ffd33d80",
    "editor.findMatchHighlightForeground": "#ffffff",
    "editor.findRangeHighlightBackground": "#ffffff15"
  },
  "security.workspace.trust.untrustedFiles": "open",
  "extensions.ignoreRecommendations": true,
  "editor.accessibilitySupport": "off",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "go.toolsManagement.autoUpdate": true,
  "github.copilot.chat.agent.currentEditorContext.enabled": false,
  "editor.inlineSuggest.edits.allowCodeShifting": "never",
  "editor.inlineSuggest.edits.renderSideBySide": "never",
  "editor.inlineSuggest.edits.showLongDistanceHint": false,
  "github.copilot.nextEditSuggestions.allowWhitespaceOnlyChanges": false,
  "github.copilot.nextEditSuggestions.enabled": false,
  "github.copilot.nextEditSuggestions.fixes": false,
  "github.copilot.nextEditSuggestions.extendedRange": false,
  "workbench.browser.searchEngine": "google",
  // localhostのリンクをエディタではなくデフォルトブラウザで開く
  "workbench.browser.openLocalhostLinks": false,
}
